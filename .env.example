# Required: Tiger Data (TimescaleDB) service URL, from the Tiger Console config file.
TIMESCALE_SERVICE_URL=postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Optional: schema for Earwitness tables (default: earwitness).
# EARWITNESS_DB_SCHEMA=earwitness

# Required to upload, re-run or delete (viewing needs no login): Auth0.
# AUTH0_CLIENT_ID is the Single Page Application's client ID; AUTH0_AUDIENCE is
# the identifier of the Auth0 API whose access tokens the server accepts.
AUTH0_DOMAIN=<tenant>.<region>.auth0.com
AUTH0_CLIENT_ID=<spa-client-id>
AUTH0_AUDIENCE=https://earwitness.api

# Optional extras
# OPENAI_API_KEY=sk-...
# EARWITNESS_GEOSLEUTH=~/.cache/earwitness/vendor/geo-sleuth/skills/geo-sleuth
