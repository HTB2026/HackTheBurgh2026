# Required: Tiger Data (TimescaleDB) service URL, from the Tiger Console config file.
TIMESCALE_SERVICE_URL=postgres://tsdbadmin:<password>@<host>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Optional: schema for Earwitness tables (default: earwitness).
# EARWITNESS_DB_SCHEMA=earwitness

# Required to upload, re-run or delete (viewing needs no login): Auth0.
# AUTH0_CLIENT_ID is the Single Page Application's client ID; AUTH0_AUDIENCE is
# the identifier of the Auth0 API whose access tokens the server accepts.
AUTH0_DOMAIN=<tenant>.<region>.auth0.com
AUTH0_CLIENT_ID=<spa-client-id>
AUTH0_AUDIENCE=https://earwitness.api
# Who may rerun or delete any case, not just their own: Auth0 user ids or
# verified emails, comma-separated. Everyone else can only change their uploads.
EARWITNESS_ADMINS=

# Optional extras
# AI checks (speech, sounds, visual analyst, geolocation, written summary).
# Set either key, or both to let each case pick its provider in the UI.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# Provider for cases that don't choose (default: the first with a key, OpenAI first).
# A self-hosted model through Ollama (Gemma 4 by default: text, images and audio).
# EARWITNESS_OLLAMA_URL=http://10.8.96.3:11434
# EARWITNESS_OLLAMA_MODEL=gemma4
# EARWITNESS_AI_PROVIDER=gemini   # openai | gemini | ollama
# Optional model overrides: EARWITNESS_OPENAI_MODEL, EARWITNESS_GEMINI_MODEL,
# EARWITNESS_GEMINI_CHECK_MODEL (second transcript model), EARWITNESS_AUDIO_MODEL.
# EARWITNESS_GEOSLEUTH=~/.cache/earwitness/vendor/geo-sleuth/skills/geo-sleuth
# Deep-effort geolocation (optional; skipped with a note without it). Star fields
# are identified offline by the vendored tetra3 solver and need no key.
# MAPILLARY_TOKEN=MLY|...          # street-level photos near each candidate (mapillary.com/dashboard/developers)
